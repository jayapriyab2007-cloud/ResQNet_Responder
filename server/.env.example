# ResQNet Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the real .env file to version control

# Server Port
PORT=5000

# CORS Origins (comma-separated or set individually)
CLIENT_URL=http://localhost:3001
RESPONDER_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/resqnet?appName=ResQNet&authSource=admin

# JWT Secret — use a long, random, unique string in production
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION

# ESP32 LoRa Gateway API Key
# The ESP32 firmware must send this as header: X-Gateway-Key: <value>
GATEWAY_API_KEY=CHANGE_THIS_TO_A_SECURE_GATEWAY_KEY

# Node Environment: development | production
NODE_ENV=development
